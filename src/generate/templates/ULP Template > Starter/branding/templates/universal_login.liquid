<!doctype html>
<html lang="{{locale}}" dir="{{dir}}">
  <head>
    <style>
      ._widget {
        --shadow-component-outer: 0px 1px 3px 0px rgba(0, 0, 0, 0.2), 0px 1px 2px -1px rgba(0, 0, 0, 0.2);
      }
    </style>

    {%- auth0:head -%}

    <script>
      window.apivantGetCookie = (name) => {
        const cookieVals = document.cookie.split(";").map(el => el.trim());
        const maybeCookie = cookieVals.filter(el => el.startsWith(name + "=")).pop() || "";
        return maybeCookie.split("=")[1]?.toLowerCase();
      }
    </script>

    {% if application.logo_url %}
    <style>
      #custom-prompt-logo { background-image: url({{application.logo_url}}); }
    </style>
    {% endif %}
    
  </head>
  <body class="_widget-auto-layout" data-prompt="{{prompt.name}}" data-screen="{{prompt.screen.name}}">
    {%- auth0:widget -%}
  </body>
</html>

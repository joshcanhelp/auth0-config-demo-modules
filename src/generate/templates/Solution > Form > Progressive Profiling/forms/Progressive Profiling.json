            "type": "CUSTOM",
            "label": "+ add address line 2 (optional)",
            "required": false,
            "sensitive": false,
            "config": {
              "schema": {},
              "code": "function addressLine2() {\n  const wrap = document.createElement('div');\n\n  const toggle = document.createElement('a');\n  toggle.href = '#';\n  toggle.className = 'dt-add-line2';\n  toggle.textContent = 'address line 2 (optional)';\n\n  const input = document.createElement('input');\n  input.type = 'text';\n  input.placeholder = 'Address Line 2';\n  input.className = 'dt-line2-input';\n  input.hidden = true;\n\n  toggle.addEventListener('click', (e) => {\n    e.preventDefault();\n    input.hidden = false;\n    toggle.hidden = true;\n    input.focus();\n  });\n\n  wrap.appendChild(toggle);\n  wrap.appendChild(input);\n\n  return {\n    init() { return wrap; },\n    block() { input.disabled = true; },\n    unblock() { input.disabled = false; },\n    getValue() { return input.hidden ? '' : input.value; }\n  };\n}",
              "css": ".dt-add-line2 {\n  display: inline-block;\n  color: #0057b8;\n  font-size: 13px;\n  text-decoration: none;\n  margin-bottom: 8px;\n}\n.dt-line2-input {\n  width: 100%;\n  padding: 10px 12px;\n  border: 1px solid #ccc;\n  border-radius: 2px;\n  box-sizing: border-box;\n}"

{
  "name": "auth0-config-demo-modules",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "exports": {
    "./src/*": "./src/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "tsx serve.ts",
    "cli": "tsx bin/demo.ts",
    "export": "tsx src/scripts/export.ts",
    "generate": "tsx src/generate/run.ts",
    "import": "tsx src/scripts/import.ts",
    "refresh": "tsx src/scripts/refresh.ts",
    "watch": "tsx src/scripts/watch.ts",
    "report": "tsx src/report/run.ts",
    "validate": "tsx src/validate/run.ts",
    "validate:list": "tsx src/validate/list.ts",
    "modules:local": "npm install auth0-config-demo-modules@file:.",
    "modules:remote": "npm install auth0-config-demo-modules@github:joshcanhelp/auth0-config-demo-modules#main",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write ./src ./packages ./bin"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "eslint": "^9.0.0",
    "eslint-plugin-unused-imports": "^1.1.3",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "auth0": "^6.3.0",
    "auth0-checkmate": "file:../auth0-checkmate",
    "auth0-deploy-cli": "file:../auth0-deploy-cli",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "dotenv": "^17.4.2",
    "eslint-config-prettier": "^6.15.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "zod": "^4.4.3"
  }
}

{
  "name": "auth0-config-demo-modules",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "bin": {
    "demo": "./bin/demo.ts"
  },
  "exports": {
    "./src/*": "./src/*",
    "./packages/*": "./packages/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "tsx serve.ts",
    "init": "tsx bin/demo.ts init",
    "pull": "tsx bin/demo.ts pull",
    "pussh": "tsx bin/demo.ts push",
    "export": "tsx src/scripts/export.ts",
    "generate": "tsx src/generate/run.ts",
    "import": "tsx src/scripts/import.ts",
    "refresh": "tsx src/scripts/refresh.ts",
    "watch": "tsx src/scripts/watch.ts",
    "report": "tsx src/report/run.ts",
    "validate": "tsx bin/demo.ts validate",
    "validate:list": "tsx bin/demo.ts validate-list",
    "modules:local": "npm install auth0-config-demo-modules@file:.",
    "modules:remote": "npm install auth0-config-demo-modules@github:joshcanhelp/auth0-config-demo-modules#main",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write ./src ./packages ./bin"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "auth0-deploy-cli": "github:joshcanhelp/auth0-deploy-cli#josh-main",
    "eslint": "^9.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "auth0": "^7.8.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "dotenv": "^17.4.2",
    "eslint-config-prettier": "^6.15.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "puppeteer@25.17.0": true
  }
}

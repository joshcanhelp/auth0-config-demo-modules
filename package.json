{
  "name": "auth0-config-demo-modules",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start": "tsx serve.ts",
    "export": "tsx src/scripts/export.ts",
    "generate": "tsx src/generate/run.ts",
    "import": "tsx src/scripts/import.ts",
    "refresh": "tsx src/scripts/refresh.ts",
    "watch": "tsx src/scripts/watch.ts",
    "deploy-ulp": "tsx src/scripts/deploy-ulp.ts",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write ./src",
    "build-deploy": "rm -rf ./auth0-config-demo-modules && rm -rf ./auth0-deploy-cli && git clone https://github.com/joshcanhelp/auth0-config-demo-modules.git && git clone -b josh-main https://github.com/joshcanhelp/auth0-deploy-cli.git && npm install ./auth0-config-demo-modules && npm ci"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "eslint": "^9.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "auth0": "^6.3.0",
    "auth0-deploy-cli": "file:../auth0-deploy-cli",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "zod": "^4.4.3"
  }
}

<p><a href="/client/{{ clientId }}">&larr; Back</a></p>
{% if state == "script" %}
<h1>Change Password - {{ clientName }}</h1>
<p id="status"></p>
<div id="action-section" style="display:none;">
  <p>Logged in as: <strong id="user-email-display"></strong></p>
  <button id="change-password-btn">Send Change Password Email</button>
</div>
<script id="change-password-config" type="application/json">{{ pageConfigJson }}</script>
<script>{{ changePasswordScript }}</script>
{% else %}
<h1>Change Password</h1>
{% if state == "no-db" %}
<p>No database connection is configured for this client. Password change is only supported for database connections.</p>
{% elsif state == "no-user" %}
<p>No user is logged in. <a href="/login/{{ clientId }}">Please login</a> to use this feature.</p>
{% elsif state == "success" %}
<p style="color:#1a7f37;">&#10003; Password change email sent to {{ userEmail }}. Check your inbox.</p>
{% elsif state == "error" %}
<p style="color:#cf222e;">Failed to send password change email: {{ errorMessage }}</p>
{% endif %}
{% endif %}

{
  "id": "af_jirGfm81N7rJWjYYCzbveB",
  "name": "Generate OTP & Send email",
  "actions": [
    {
      "id": "generate_otp",
      "type": "OTP",
      "action": "GENERATE_CODE",
      "allow_failure": false,
      "mask_output": false,
      "params": {
        "reference": "{{context.user.email}}",
        "length": 6
      }
    },
    {
      "id": "send_email",
      "type": "AUTH0",
      "action": "SEND_EMAIL",
      "allow_failure": false,
      "mask_output": false,
      "params": {
        "to": "{{vars.email}}",
        "subject": "TWIA/TFPA Verify Your Email Address",
        "body": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html dir=\"ltr\" lang=\"en\">\n  <head>\n    <meta content=\"text/html; charset=UTF-8\" http-equiv=\"Content-Type\" />\n    <meta name=\"x-apple-disable-message-reformatting\" />\n    <title>Password Change Request</title>\n  </head>\n  <div style=\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0;\">\n    We need to verify the email on your account.\n  </div>\n\n  <body\n    style=\"margin:0;padding:24px;background-color:#D1DCF0;font-family:Arial, Helvetica, sans-serif;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;color:#232523;\"\n  >\n    <table\n      align=\"center\"\n      width=\"100%\"\n      border=\"0\"\n      cellpadding=\"0\"\n      cellspacing=\"0\"\n      role=\"presentation\"\n      style=\"width:100%;background-color:#D1DCF0;\"\n    >\n      <tbody>\n        <tr>\n          <td align=\"center\">\n            <table\n              align=\"center\"\n              width=\"100%\"\n              border=\"0\"\n              cellpadding=\"0\"\n              cellspacing=\"0\"\n              role=\"presentation\"\n              style=\"max-width:600px;background-color:#ffffff;border-radius:10px;box-shadow:0 8px 24px rgba(17,40,75,0.12);\"\n            >\n              <tbody>\n                <!-- Header -->\n                <tr>\n                  <td align=\"center\" style=\"padding:25px 32px 20px 32px;text-align:center;\">\n                    {% assign logoAnchorCss = \"display:block;height:100px;width:auto;max-width:100%;border:0;outline:none;text-decoration:none;margin:0 auto;\" %}\n                    {% assign logoImgCss = \"display:block;height:100px;width:auto;max-width:100%;border:0;outline:none;text-decoration:none;margin:0 auto;\" %}\n                    {% if user.app_metadata.company == \"twia\" %}\n                    <a href=\"https://www.twia.org/\" target=\"_blank\" style=\"{{ logoAnchorCss }}\">\n                      <img alt=\"TWIA Logo\" src=\"https://branding.twia.org/$web/twia-logo.png\" style=\"{{ logoImgCss }}\" />\n                    </a>\n                    {% elsif user.app_metadata.company == \"tfpa\" %}\n                    <a href=\"https://www.texasfairplan.org/\" target=\"_blank\" style=\"{{ logoAnchorCss }}\">\n                      <img alt=\"TFPA Logo\" src=\"https://branding.twia.org/$web/tfpa-logo.png\" style=\"{{ logoImgCss }}\" />\n                    </a>\n                    {% else %}\n                    <a href=\"https://www.twia.org/\" target=\"_blank\" style=\"{{ logoAnchorCss }}\">\n                      <img alt=\"TWIA/TFPA Logo\" src=\"https://branding.twia.org/$web/twia-logo.png\" style=\"{{ logoImgCss }}\" />\n                    </a>\n                    {% endif %}\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:0 32px;\">\n                    <hr style=\"border:none;border-top:1px solid #E8E7E5;margin:0;\" />\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:16px 32px 8px 32px;text-align:left;\">\n                 \n\n                    <h1\n                      style=\"margin:0 0 12px 0;font-size:28px;line-height:1.2;font-weight:700;color:#11284B;text-align:left;\"\n                    >\n                    Verify Your Email </h1>\n\n\n                  </td>\n                </tr>\n                <!-- Step 1 -->\n                <tr>\n                  <td style=\"padding:0 32px 0 32px;\">\n                    <p style=\"margin:0 0 12px 0;font-size:14px;line-height:20px;mso-line-height-rule:exactly;font-weight:400;color:#232523;\">\n                    We need to verify the email on your user account. Please enter the  code below on the verification page. </p>\n\n                    <p style=\"margin:16px 0 0 0;font-size:14px;line-height:20px;mso-line-height-rule:exactly;font-weight:700;color:#11284B;\">\n                    Your Verification Code:</p>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:0 32px 0 32px;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                      <tbody>\n                        <tr>\n                    <p style=\"margin:32px 0 18px 0;font-size:28px;line-height:20px;mso-line-height-rule:exactly;font-weight:600;\">\n                      {{custom_vars.code}}\n                    </p>\n                        </tr>\n                      </tbody>\n                    </table>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:28px 32px 0 32px;\">\n                    <p\n                      style=\"margin:0 0 12px 0;font-size:14px;line-height:20px;font-weight:700;color:#11284B;\"\n                    >\n                      Need help?\n                    </p>\n                    <p\n                      style=\"margin:0 0 8px 0;font-size:14px;line-height:20px;font-weight:500;color:#232523;\"\n                    >\n                      If you did not submit this request or if you are having issues with your account, \n\t\t\t\t\t\t          {% assign contactAnchorCss = \"color:#267DC1;text-decoration:underline;font-weight:700;\" %}\n                      {% if user.app_metadata.company == \"tfpa\" %}\n                      <a href=\"https://www.texasfairplan.org/about-us/contacts/\" target=\"_blank\" style=\"{{ contactAnchorCss }}\">contact us</a>.\n                      {% else %}\n                      <a href=\"https://www.twia.org/about-us/contact-us/\" target=\"_blank\" style=\"{{ contactAnchorCss }}\">contact us</a>.\n                      {% endif %}\n                    </p>\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:24px 32px 0 32px;\">\n                    <hr style=\"border:none;border-top:1px solid #E8E7E5;margin:0;\" />\n                  </td>\n                </tr>\n\n                <!-- Footer -->\n                <tr>\n                  <td style=\"padding:20px 32px 24px 32px;\">\n                    <p style=\"margin:0;font-size:12px;line-height:18px;mso-line-height-rule:exactly;font-weight:400;color:#635238;\">\n                      You’re receiving this email because you have an account with us. The content of this email is provided for your information and convenience. In the event of any conflict, the applicable policy or account documents shall be controlling.\n                      <br /><br />\n\t\t\t\t\t\t<a href=\"https://www.twia.org/terms-and-conditions/\" target=\"_blank\" style=\"color:#267DC1;text-decoration:underline;font-weight:700;\">Terms &amp; Conditions</a>\n\t\t\t\t\t\t<br /><br />\n                      Please do not reply to this email. This mailbox cannot receive messages.\n                    </p>\n                  </td>\n                </tr>\n              </tbody>\n            </table>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </body>\n</html>\n",
        "custom_vars": {
          "code": "{{actions.generate_otp.code}}"
        }
      }
    }
  ]
}
